{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rawskap Transfer",
  "version": "0.1.2",
  "identifier": "no.rawstudios.rawskap-transfer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Rawskap Transfer",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1060,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "rawskap"
        ]
      }
    }
  }
}